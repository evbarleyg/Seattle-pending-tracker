{
  "name": "seattle-pending-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Seattle Housing Buyer Lens static app",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "lint": "node scripts/run_checks.js lint",
    "typecheck": "node scripts/run_checks.js typecheck",
    "test": "node --test tests/*.test.js",
    "pending:2026": "node scripts/export_2026_pending_context.js",
    "scrape:pending2026": "node scripts/export_2026_pending_context.js",
    "fetch:actives": "node scripts/fetch_redfin_actives.js",
    "merge:actives": "node scripts/merge_redfin_actives.js",
    "refresh:actives": "node scripts/fetch_redfin_actives.js && node scripts/merge_redfin_actives.js && node scripts/sync_public_assets.js",
    "build:url-index": "node scripts/build_redfin_url_index.js",
    "backfill:history": "node scripts/backfill_redfin_history.js",
    "detect:transitions": "node scripts/detect_listing_transitions.js",
    "refresh:kc": "bash scripts/refresh_kc_data.sh",
    "sync:public": "node scripts/sync_public_assets.js",
    "validate:data": "node scripts/run_checks.js build",
    "build": "npm run validate:data && npm run sync:public && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide": "^1.11.0",
    "vite": "^8.0.10"
  }
}
